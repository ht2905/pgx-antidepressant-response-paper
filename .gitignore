# ----------------------------------------------------------------------------
# RStudio & R Environment
# ----------------------------------------------------------------------------

# User-specific data and temporary files
.Rproj.user/
.RData
.RDataTmp
.Ruserdata
.Rhistory

# Python Virtual Environments & Temp Dirs (Hygiene rule)
.venv/
venv/
temp/
logs/
artifacts/

# renv: ignore cache/library, track activation and lockfile
/renv/
!/renv/activate.R
!/renv/settings.json
!renv.lock

# ----------------------------------------------------------------------------
# Quarto & Knitr Build Artifacts & Intermediates
# ----------------------------------------------------------------------------

.quarto/
*_files/
*_cache/
cache/
_freeze/
**/*.quarto_ipynb

# Intermediate Markdown
*.utf8.md
*.knit.md

# LaTeX compilation intermediates
*.aux
*.bbl
*.blg
*.fff
*.log
*.nav
*.out
*.snm
*.toc
*.synctex.gz
*.spl

# Intermediate LaTeX files (whitelisting preamble)
*.tex
!manuscript_preamble.tex

# Package build and testing artifacts
*.tar.gz
*.Rcheck/

# Standalone root copies of extension files (tracked under _extensions/)
/elsarticle.cls
/elsarticle-harv.bst
/elsarticle-num.bst
/elsevier-vancouver.csl

# ----------------------------------------------------------------------------
# OS & System Files
# ----------------------------------------------------------------------------

Thumbs.db
.DS_Store

# ----------------------------------------------------------------------------
# Tracked publication deliverables & extensions
# ----------------------------------------------------------------------------

# Keep rendered publication manuscript tracked
!pgx-antidepressant-response_article.pdf
!assignment_cover-page.pdf

# Track Elsevier template extension for reproducible offline / CI rendering
!_extensions/
!_extensions/**

/.quarto/
